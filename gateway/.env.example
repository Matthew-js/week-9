# Port gateway (lokal: 8080). Di Render, JANGAN diisi: Render mengaturnya sendiri.
PORT=8080

# Alamat service di belakang gateway (tanpa garis miring di akhir).
PRODUCT_SERVICE_URL=http://localhost:3000
ORDER_SERVICE_URL=http://localhost:3001

# Jumlah proxy di depan gateway. Lokal: 0. Di Render: 1.
TRUST_PROXY=0
